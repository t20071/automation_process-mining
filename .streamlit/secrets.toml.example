# Copy to .streamlit/secrets.toml for local runs, or paste into
# Streamlit Cloud → App settings → Secrets.  Never commit the real file.
GROQ_API_KEY = "gsk_your_key_here"
LLM_PROVIDER = "groq"                      # or "deterministic"
GROQ_MODEL = "llama-3.3-70b-versatile"
CONFIDENCE_THRESHOLD = "0.80"
