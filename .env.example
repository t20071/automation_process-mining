# ============================================================
# Process Intelligence + Agentic Automation Engine
# Copy this file to .env and fill in real values.
# NEVER commit .env — it is gitignored.
# ============================================================

# --- LLM Provider ---
# Options: "groq" (live API, for demos) | "deterministic" (tests, no network)
LLM_PROVIDER=deterministic

# --- Groq API ---
# Get a free key at https://console.groq.com
# Required only when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# --- Agent Gate ---
# Minimum confidence for auto-approval (0.0 – 1.0)
CONFIDENCE_THRESHOLD=0.80

# --- Log Generator ---
# Number of synthetic cases to generate
NUM_CASES=2000
